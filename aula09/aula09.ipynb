   ],
   "source": [
    "def soma_digitos(n):\n",
    "    if n < 10:\n",
    "        return n\n",
    "    else:\n",
    "        return n % 10 + soma_digitos(n // 10)\n",
    "\n",
    "numero = int(input(\"Digite um número inteiro positivo: \"))\n",
    "\n",
    "print(\"A soma dos dígitos é:\", soma_digitos(numero))"
   ]
  },
