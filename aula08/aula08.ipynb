   "source": [
    "def get_length(linked_list):\n",
    "    count=0\n",
    "    current = linked_list.head\n",
    "    while current:\n",
    "        count += 1\n",
    "        current = current.next\n",
    "    return count\n",
    "\n"
   ]
  }
